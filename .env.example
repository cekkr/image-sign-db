# Image Sign DB — example environment
#
# Copy to `.env` (git-ignored) and edit:
#
#   cp .env.example .env
#
# This file configures **Cheetah** as the only database. MySQL is deprecated
# and its block sits at the bottom, fully commented out — you do not need a
# MySQL server to run the sign pipeline.
#
# Commented lines are the shipped default and exist to document the knob, not
# because they need setting; uncommented lines are values this file sets
# deliberately. `src/settings.js` is the authoritative list — if a value here
# disagrees with it, that file wins.
#
# Values are read by dotenv at require time (src/settings.js). Anything empty
# or unparseable falls back to the default, so `FOO=` is the same as unset.

# =============================================================================
# Storage backend
# =============================================================================
# Routes the **delta family** at Cheetah. Note the scope: on this revision that
# path covers ingestion (exhaustive plus the random first progressive cycle)
# with completion gating and payload-budget pruning. Search, evaluation, guided
# ingestion, discovery, image deletion and graph-aware pruning are NOT ported
# for that family — those delta-family commands still need the deprecated MySQL
# block below.
#
# The **sign pipeline** (src/sign.js, src/signPipeline.js) is Cheetah-native
# end to end — train, search and evaluate all run — and ignores this variable
# entirely. It is the pipeline this configuration is meant for.
STORAGE_BACKEND=cheetah

# Payload budget used by the pruners, in GiB.
#DEFAULT_MAX_DB_SIZE_GB=10

# =============================================================================
# HTTP server and client
# =============================================================================
#PORT=3000
#API_BASE_URL=http://localhost:3000
#CLIENT_MAX_ITERATIONS=10

# =============================================================================
# Cheetah DB (submodule) — the database.
#
# Requires the submodule checked out (`git submodule update --init`) and, for a
# local server, the binary built from it:
#   cd cheetah && go build -o ../cheetah-server ./src
#
# CHEETAH_DATA_DIR / CHEETAH_PAIR_INDEX_BYTES / CHEETAH_GRAPH_TERM_INDEX are
# read by the Go server too — src/lib/cheetah/server.js spawns it for
# development and tests.
# =============================================================================
#CHEETAH_HOST=127.0.0.1
#CHEETAH_PORT=4455
#CHEETAH_DATABASE=image_sign_db
#CHEETAH_DATA_DIR=cheetah_data
#CHEETAH_POOL_SIZE=4
#CHEETAH_CONNECT_TIMEOUT_MS=5000
#CHEETAH_COMMAND_TIMEOUT_MS=30000
#CHEETAH_MAX_IN_FLIGHT=64
# Byte-wise TCP frames are the default. Disable only for a staged connection to
# a Cheetah server that predates binary protocol support.
#CHEETAH_BINARY_PROTOCOL=true
# Pair index stride. Honoured only when the store is created — pairs/format.dat
# wins on every later open, so this must be right the first time (ROADMAP §4).
#CHEETAH_PAIR_INDEX_BYTES=2
# Off by design: hex node ids sharing a lexical token cross-match in
# GRAPH_RECALL, and the index costs a write per node upsert (ROADMAP §3.3).
#CHEETAH_GRAPH_TERM_INDEX=false

# Set to 1 to un-skip the live Cheetah round-trips in test/ (needs a Go
# toolchain; `npm run test:integration` sets it for you). Not read by src/.
#CHEETAH_INTEGRATION=1

# =============================================================================
# Sign pipeline (src/lib/sign/). Operational knobs only — the quantisation
# tables that decide which vocabulary word a measurement falls into are frozen
# in src/lib/sign/constants.js and are deliberately not env vars.
# =============================================================================
#SIGN_CONSTELLATIONS_PER_IMAGE=3600
#SIGN_POINT_COUNT=7
#SIGN_POINT_PATCH_REL=0.004
#SIGN_WORKING_MAX_SIDE=1024
# Pinning where the centre sits makes a sign refuse to match the same subject
# at another aspect ratio; off by default.
#SIGN_WITH_CENTRE_POSITION=false

# Adaptive training: stop once more constellations stop buying
# discriminability. Off by measurement, not principle — see src/settings.js.
#SIGN_TRAIN_ADAPTIVE=false
#SIGN_TRAIN_CHECK_EVERY=512
#SIGN_TRAIN_PROBES=3
#SIGN_TRAIN_MIN_GAIN=0.01
#SIGN_TRAIN_STOP_MIN_HIT_RATE=1
#SIGN_TRAIN_MIN_CORPUS=4
#SIGN_TRAIN_PROBE_MAX=96
# How far an image still improving at the ceiling may keep going; 0 disables.
#SIGN_TRAIN_EXTEND_TO=0

#SIGN_SEARCH_BATCH=12
#SIGN_SEARCH_MIN_CONSTELLATIONS=24
#SIGN_SEARCH_MAX_CONSTELLATIONS=720
#SIGN_SEARCH_STOPWORD_RATIO=0.6
#SIGN_SEARCH_SEEDS_PER_ROUND=96
# Pivoted length normalisation. 0 measured strictly best; see src/settings.js.
#SIGN_SEARCH_LENGTH_SLOPE=0
# Stop thresholds: leader's mass as a multiple of the uniform share 1/corpus,
# and its lead over the runner-up.
#SIGN_SEARCH_CONFIDENCE_MULTIPLE=2
#SIGN_SEARCH_SEPARATION=1.35
#SIGN_SEARCH_RERANK_TOP=5
#SIGN_SEARCH_RERANK_SIGNS=12

# =============================================================================
# Delta-family measurement geometry
#
# WARNING: these change stored identity. SAMPLES_PER_AUGMENTATION shifts every
# sample_id, and the resolution-level pair changes descriptor rounding and
# candidate matching — any change orphans an existing corpus. Set them before
# the first ingest or not at all.
# =============================================================================
#CONSTELLATION_SAMPLES_PER_AUGMENTATION=10000
# Legacy alias, read only when the above is unset.
#SAMPLES_PER_AUGMENTATION=10000
#RESOLUTION_LEVEL_PRECISION=6
# src/lib/cheetah/keys.js throws at load if this is widened past half a bucket.
#RESOLUTION_LEVEL_TOLERANCE=0.0001

# =============================================================================
# Search / matching thresholds — delta family only (MySQL paths)
# =============================================================================
#VALUE_THRESHOLD=0.08
#SKIP_THRESHOLD=3
#CLI_MAX_ITERATIONS=12

# Correlation discovery. MIN_AFFINITY and MIN_COHESION are applied in search
# and evaluation too, not just discovery: raising them silently deletes matches
# from /search results and from --evaluate tables.
#CORRELATION_SIMILARITY_THRESHOLD=0.2
#CORRELATION_MAX_CANDIDATE_SAMPLE=512
#CORRELATION_MIN_AFFINITY=0.45
#CORRELATION_MIN_COHESION=0.25
# Legacy alias, read only when CORRELATION_MIN_COHESION is unset.
#CORRELATION_MIN_SPREAD=0.25
#ONLINE_RUNNER_MAX_BATCH_SIZE=6
#ONLINE_RUNNER_MAX_BATCH_SIZE_CAP=12

# =============================================================================
# Training (src/train.js) — delta family. Under STORAGE_BACKEND=cheetah only
# ingestion runs, so the correlation/self-eval/pruning knobs below are inert;
# DEFAULT_THREADS is additionally forced to 1 there.
# =============================================================================
#DEFAULT_DISCOVER_ITERATIONS=3
#DEFAULT_BOOTSTRAP_ITERATIONS=0
#DEFAULT_REPROBE_COUNT=0
#DEFAULT_SHUFFLE=true
# Worker count; unset means auto-sized. Forced to 1 for STORAGE_BACKEND=cheetah
# (token allocation is process-local).
#DEFAULT_THREADS=
#RESOURCE_SAMPLE_INTERVAL_MS=2500
#BOOTSTRAP_COMMAND_DEFAULT_ITERATIONS=75
#TRAINING_MIN_COMPLETED_IMAGE_AGE_MINUTES=0

#TRAINING_AUGMENTATIONS_PER_IMAGE=3
# Comma-separated; empty means the built-in set.
#TRAINING_AUGMENTATION_LIST=
# Seed mixed into stochastic augmentations so a run is reproducible.
#TRAINING_AUGMENTATION_GLOBAL_SEED=

#TRAINING_PROGRESSIVE_ENABLED=true
#TRAINING_PROGRESSIVE_CYCLES=3
#TRAINING_PROGRESSIVE_RANDOM_PER_AUG=300
#TRAINING_PROGRESSIVE_GUIDED_PER_CYCLE=300

#TRAINING_SELF_EVAL_ENABLED=true
#TRAINING_SELF_EVAL_MAX_SAMPLES=8
#TRAINING_SELF_EVAL_RUNS=1
#TRAINING_SELF_EVAL_TOP=3
# Comma-separated augmentation names.
#TRAINING_SELF_EVAL_FILTERS=original

#TRAINING_REALTIME_PRUNING_ENABLED=true
#TRAINING_REALTIME_PRUNING_INTERVAL_MS=60000
#TRAINING_REALTIME_PRUNING_MIN_INGESTS=24
#TRAINING_REALTIME_PRUNING_BATCH_SIZE=24
#TRAINING_REALTIME_PRUNING_VECTOR_BATCH=400
# Defaults to max(SKIP_THRESHOLD, 4).
#TRAINING_REALTIME_PRUNING_MIN_SKIP=4
#TRAINING_REALTIME_PRUNING_MIN_GROUP_AGE_MINUTES=45
#TRAINING_REALTIME_PRUNING_MAX_GROUP_HIT_COUNT=1

# Keep a copy of the original image in the database for re-vectorization.
#STORE_IMAGE_BLOB=false

# =============================================================================
# Logging / debug
# =============================================================================
#TRAINING_CORRELATION_DEBUG_LOG=false
#TRAINING_CORRELATION_TOP_LOG_K=5
#TRAINING_VERBOSE_AUGMENT_LOGS=false
# Progress lines per augmentation; only used when the flag above is on.
#AUG_PROGRESS_STEPS=

# =============================================================================
# MySQL — DEPRECATED
#
# The project is migrating off MySQL onto Cheetah (ROADMAP.md). Leave this
# block commented out unless you are running a delta-family command that has no
# Cheetah path yet — search, evaluation, guided ingestion, discovery, image
# deletion — in which case set STORAGE_BACKEND=mysql above and fill these in.
# The sign pipeline never touches MySQL.
#
# Credentials reach mysql2 only from these four variables. Never hard-code
# them, never log process.env, and never write them into `system_settings`.
# =============================================================================
#DB_HOST=localhost
#DB_USER=root
#DB_PASSWORD=
#DB_NAME=image_hypercube_db

# Retry envelope for transient MySQL errors during ingestion
# (src/featureExtractor.js).
#DB_OPERATION_MAX_RETRIES=4
#DB_OPERATION_RETRY_BASE_MS=40
